    }

}

.hero h1 {
    font-size: clamp(3rem, 10vw, 9rem);
    letter-spacing: 0.06em;
    white-space: nowrap;
}

@media (max-width: 600px) {

    .hero h1 {
        font-size: clamp(2.2rem, 12vw, 4.5rem);
        letter-spacing: 0.03em;
    }

}
